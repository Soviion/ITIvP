# Адрес REST API (сервер из лабораторных работ 1–3). Без завершающего слэша.
VITE_API_URL=http://localhost:3000

# Необязательно: искусственная задержка каждого запроса в миллисекундах.
# Нужна, чтобы на защите было видно спиннер загрузки и оптимистичное обновление интерфейса (например, 1500). 0 — выключено.
VITE_API_DELAY_MS=0
